# RVISS C 验证配置：默认设备齐全，-O2，带调试信息（发布/日常跑用）
# 用法: make c_defconfig

CONFIG_TARGET_RISCV64=y

CONFIG_CC_O2=y
CONFIG_CC_DEBUG=y
CONFIG_CC_STRICT=y
CONFIG_CC_LTO=n
CONFIG_CC_NATIVE=n

CONFIG_ENGINE_INTERPRETER=y

CONFIG_DEBUG=y
CONFIG_TRACE_INST=n
CONFIG_TRACE_INST_DASM=n
CONFIG_TRACE_MEM=n
CONFIG_TRACE_MMU=n
CONFIG_SHARE=n

CONFIG_MBASE=0x80000000
CONFIG_MSIZE=0x8000000
CONFIG_PC_RESET_OFFSET=0x0

CONFIG_HAS_CLINT=y
CONFIG_HAS_UART16550=y
CONFIG_HAS_PLIC=y

CONFIG_RV_ZICSR=y

CONFIG_RV_C=y
