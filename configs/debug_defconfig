# RVISS 调试配置：-O0 + 全量 trace，专供 gdb 单步与查 bug
# 用法: make debug_defconfig && make -j
#
#   ./build/rviss -b -t image.elf        看指令流
#   gdb -q --args ./build/rviss -b image.elf

CONFIG_TARGET_RISCV64=y

CONFIG_CC_O0=y
CONFIG_CC_DEBUG=y
CONFIG_CC_STRICT=y
CONFIG_CC_LTO=n
CONFIG_CC_NATIVE=n

CONFIG_ENGINE_INTERPRETER=y

CONFIG_DEBUG=y
CONFIG_TRACE_INST=y
CONFIG_TRACE_INST_DASM=y
CONFIG_TRACE_MEM=y
CONFIG_TRACE_MMU=y
CONFIG_SHARE=n

CONFIG_MBASE=0x80000000
CONFIG_MSIZE=0x8000000
CONFIG_PC_RESET_OFFSET=0x0

CONFIG_HAS_CLINT=y
CONFIG_HAS_UART16550=y
CONFIG_HAS_PLIC=y

CONFIG_RV_ZICSR=y
