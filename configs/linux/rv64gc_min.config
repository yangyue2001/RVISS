# Linux 6.11.4: allnoconfig 上叠加，完整结果保存在工件 linux.config。
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
CONFIG_SMP=n
CONFIG_EXPERT=y
# Linux 6.11 PORTABLE 会强制 EFI；本基线固定板级，使用 NONPORTABLE 去除 EFI。
CONFIG_NONPORTABLE=y
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_ISA_VENDOR_EXT=n
# 由 RISCV 无条件 select，保留框架；上面的额外扩展仍全部关闭。
CONFIG_RISCV_ALTERNATIVE=y
CONFIG_EFI=n
CONFIG_ACPI=n
CONFIG_MODULES=n
CONFIG_NET=n
CONFIG_PCI=n
CONFIG_BLOCK=n
CONFIG_VIRTIO_MENU=n
CONFIG_CPU_IDLE=n
CONFIG_PERF_EVENTS=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_RANDOMIZE_KSTACK_OFFSET=n
CONFIG_COMPAT=n
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LOCALVERSION="-rviss"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_DEVTMPFS=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HZ_100=y
CONFIG_LOG_BUF_SHIFT=16
CONFIG_PANIC_TIMEOUT=0
