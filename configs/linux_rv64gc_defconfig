# 固定 Linux 6.11.4 + OpenSBI generic RV64GC 单 hart 平台。
#
# Linux 侧来源：CONFIG_ARCH_RV64I=y、CONFIG_MMU=y、CONFIG_FPU=y、
# CONFIG_RISCV_ISA_C=y、CONFIG_SMP=n。
# OpenSBI 侧来源：generic + UART8250、CLINT MTIMER/MSWI、PLIC、SYSCON reset。
# 固定 DTB 声明 256 MiB RAM，因此这里不使用运行期 --memory 覆盖。

CONFIG_TARGET_RISCV64=y

CONFIG_CC_O2=y
CONFIG_CC_DEBUG=y
CONFIG_CC_STRICT=y
CONFIG_CC_LTO=n
CONFIG_CC_NATIVE=n

CONFIG_ENGINE_INTERPRETER=y

CONFIG_DEBUG=y
CONFIG_TRACE_INST=n
CONFIG_TRACE_INST_DASM=n
CONFIG_TRACE_MEM=n
CONFIG_TRACE_MMU=n
CONFIG_SHARE=n

CONFIG_MBASE=0x80000000
CONFIG_MSIZE=0x10000000
CONFIG_PC_RESET_OFFSET=0x0

CONFIG_RV64_LINUX=y
# RV64_LINUX 同时选择 Zicsr/Zifencei/Zicntr；显式写出以便审查生成配置。
CONFIG_RV_ZIFENCEI=y
CONFIG_RV_ZICNTR=y
CONFIG_RV_MISALIGNED_TRAP=y
