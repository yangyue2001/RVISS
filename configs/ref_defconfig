# RVISS difftest 参考模型配置：产出 librviss_ref.so 供 DUT dlopen
# 用法: make ref_defconfig && make -j
#
# 当前仅验证共享库构建；尚未通过真实 DUT consumer 的 ABI 契约测试。
# 声明见 include/rviss.h，不能据此宣称 NEMU/香山兼容。

CONFIG_TARGET_RISCV64=y

CONFIG_CC_O2=y
CONFIG_CC_DEBUG=n
CONFIG_CC_STRICT=y
CONFIG_CC_LTO=n
CONFIG_CC_NATIVE=n

CONFIG_ENGINE_INTERPRETER=y

CONFIG_DEBUG=n
CONFIG_TRACE_INST=n
CONFIG_TRACE_INST_DASM=n
CONFIG_TRACE_MEM=n
CONFIG_TRACE_MMU=n
CONFIG_SHARE=y

CONFIG_MBASE=0x80000000
CONFIG_MSIZE=0x8000000
CONFIG_PC_RESET_OFFSET=0x0

CONFIG_HAS_CLINT=y
CONFIG_HAS_UART16550=y
CONFIG_HAS_PLIC=y

CONFIG_RV_ZICSR=y
