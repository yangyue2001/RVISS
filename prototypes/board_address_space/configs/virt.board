// RVISS 只读取设备树风格的一个小子集，不依赖完整 libfdt。
/dts-v1/;

/ {
  model = "rviss,virt";
  reset-pc = <0x80000000>;

  ram0: memory@80000000 {
    device-type = "memory";
    reg = <0x80000000 0x20000>;
    status = "okay";
  };

  uart0: serial@10000000 {
    compatible = "ns16550a";
    reg = <0x10000000 0x100>;
    interrupts = <10>;
    status = "okay";
  };
};
