#
# RISC-V 扩展开关
#
# 与 Linux arch/riscv 的扩展清单对齐：先做"能跑 Linux"的必需集，
# 再做内核用到的可选加速/特性。落地顺序见 docs/implementation_plan.md。
#

menu "RISC-V extensions"

comment "基础（已实现）"

config RV_ZICSR
	bool "Zicsr（CSR 读写指令）"
	default y
	help
	  关掉后 csrrw/csrrs/csrrc 等指令变成非法指令。

config RV_ZIFENCEI
	bool "Zifencei（指令流同步）"
	default y
	help
	  提供 fence.i 指令。当前 RVISS 是有序功能模型，没有译码缓存，
	  因此 fence.i 的执行效果是合法退休但不需要刷新宿主缓存；关闭后
	  该编码变成非法指令。该开关与 Linux 的 Zifencei ISA 身份保持一致。

config RV_ZICNTR
	bool "Zicntr（基础计数器与计时器）"
	default y
	help
	  提供 cycle/time/instret 及对应机器级计数器 CSR。RVISS 的客户机
	  计数器仍与引擎事件、退休预算和平台逻辑时间分开；关闭后这些
	  CSR 不可访问。Zihpm 高性能计数器不因该选项被宣称支持。

comment "Linux 必需扩展（能力以验证任务为准）"

config RV_M
	bool "M：乘除法（mul/div/rem）"
	help
	  RV64 M 2.0 的 13 条指令；关闭时相应编码为非法指令。
config RV_A
	bool "A：原子指令（lr/sc/amo）"
	help
	  RV64 A 2.1；单 hart RAM LR/SC 和 W/D AMO，设备原子访问产生 fault。
config RV_F
	bool "F：单精度浮点"
	depends on RV_ZICSR
	help
	  F 2.2，FLEN32、五种舍入模式、FCSR 与 FS 状态。
config RV_D
	bool "D：双精度浮点"
	depends on RV_F
	help
	  D 2.2，FLEN64、单精度 NaN boxing 与 S/D 转换。
config RV_C
	bool "C：压缩指令（RVC）"
	help
	  RV64 C 2.0 整数压缩指令；misa.C 控制 IALIGN 与动态启用。
	  编译 D 时包含 C.FLD/FSD/FLDSP/FSDSP。

comment "地址翻译（Bare 始终可用；分页能力编译期选择）"

config RV_SV39
	bool "Sv39 分页"
	help
	  编译 Sv39 页表遍历器；运行时 satp.MODE=0 仍选择 Bare，MODE=8 选择 Sv39。
	  关闭此选项时只提供 Bare 地址转换；启用时仍可按运行时 satp 在两者间选择。
	  ASIDLEN=0，支持 4K/2M/1G、PMP 页表保护与硬件 A/D 更新。

# Sv48 没有实现，因此暂不提供可选的 Kconfig 符号；实现后再加入。

config RV_PMP
	bool "PMP：物理内存保护"
	help
	  16 entries，粒度 4 bytes，OFF/TOR/NA4/NAPOT；关闭时 0 entries。

comment "阶段二：可选特性（未实现）"

config RV_B
	bool "B：位操作（Zba/Zbb/Zbs）"
config RV_V
	bool "V：向量（RVV 1.0）"
config RVH
	bool "H：虚拟化（两阶段翻译）"
config RV_SSTC
	bool "Sstc：S 模式定时器"

endmenu
