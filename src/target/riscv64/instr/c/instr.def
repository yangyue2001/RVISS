#ifdef CONFIG_RV_D
CINSTR(c_fld,      0x2000, 0xe003)
CINSTR(c_fsd,      0xa000, 0xe003)
CINSTR(c_fldsp,    0x2002, 0xe003)
CINSTR(c_fsdsp,    0xa002, 0xe003)
#endif
