/*
 * RV64I 指令表 —— 唯一事实来源。
 *   INSTR(名字, 32 位模式, 操作数格式)
 * 模式串里 '0'/'1' 是固定位，'?' 是通配位；空格只为阅读。
 * 格式字母： 'R'/'I'/'X'(移位立即数)/'Z'(csr 立即数)/'S'/'B'/'U'/'J'/'N'(无操作数)
 *
 * 加一条指令 = 这里加一行 + 在 exec.c 里实现同名函数（名字自动拼接 exec_<name>）。
 * 译码表、助记符、执行入口全部由本文件生成，不再有"改三处"的问题。
 */

/* ---------------- R 型：op (0110011) ---------------- */
INSTR(add,   "0000000 ????? ????? 000 ????? 0110011", 'R')
INSTR(sub,   "0100000 ????? ????? 000 ????? 0110011", 'R')
INSTR(sll,   "0000000 ????? ????? 001 ????? 0110011", 'R')
INSTR(slt,   "0000000 ????? ????? 010 ????? 0110011", 'R')
INSTR(sltu,  "0000000 ????? ????? 011 ????? 0110011", 'R')
INSTR(xor,   "0000000 ????? ????? 100 ????? 0110011", 'R')
INSTR(srl,   "0000000 ????? ????? 101 ????? 0110011", 'R')
INSTR(sra,   "0100000 ????? ????? 101 ????? 0110011", 'R')
INSTR(or,    "0000000 ????? ????? 110 ????? 0110011", 'R')
INSTR(and,   "0000000 ????? ????? 111 ????? 0110011", 'R')

/* ---------------- I 型：op-imm (0010011) ---------------- */
INSTR(addi,  "??????? ????? ????? 000 ????? 0010011", 'I')
INSTR(slti,  "??????? ????? ????? 010 ????? 0010011", 'I')
INSTR(sltiu, "??????? ????? ????? 011 ????? 0010011", 'I')
INSTR(xori,  "??????? ????? ????? 100 ????? 0010011", 'I')
INSTR(ori,   "??????? ????? ????? 110 ????? 0010011", 'I')
INSTR(andi,  "??????? ????? ????? 111 ????? 0010011", 'I')
INSTR(slli,  "000000 ?????? ????? 001 ????? 0010011", 'X')
INSTR(srli,  "000000 ?????? ????? 101 ????? 0010011", 'X')
INSTR(srai,  "010000 ?????? ????? 101 ????? 0010011", 'X')

/* ---------------- R 型：op-32 (0111011)，32 位字运算 ---------------- */
INSTR(addw,  "0000000 ????? ????? 000 ????? 0111011", 'R')
INSTR(subw,  "0100000 ????? ????? 000 ????? 0111011", 'R')
INSTR(sllw,  "0000000 ????? ????? 001 ????? 0111011", 'R')
INSTR(srlw,  "0000000 ????? ????? 101 ????? 0111011", 'R')
INSTR(sraw,  "0100000 ????? ????? 101 ????? 0111011", 'R')

/* ---------------- I 型：op-imm-32 (0011011) ---------------- */
INSTR(addiw,  "??????? ????? ????? 000 ????? 0011011", 'I')
INSTR(slliw,  "0000000 ????? ????? 001 ????? 0011011", 'X')
INSTR(srliw,  "0000000 ????? ????? 101 ????? 0011011", 'X')
INSTR(sraiw,  "0100000 ????? ????? 101 ????? 0011011", 'X')

/* ---------------- 加载 load (0000011) ---------------- */
INSTR(lb,    "??????? ????? ????? 000 ????? 0000011", 'I')
INSTR(lh,    "??????? ????? ????? 001 ????? 0000011", 'I')
INSTR(lw,    "??????? ????? ????? 010 ????? 0000011", 'I')
INSTR(ld,    "??????? ????? ????? 011 ????? 0000011", 'I')
INSTR(lbu,   "??????? ????? ????? 100 ????? 0000011", 'I')
INSTR(lhu,   "??????? ????? ????? 101 ????? 0000011", 'I')
INSTR(lwu,   "??????? ????? ????? 110 ????? 0000011", 'I')

/* ---------------- 存储 store (0100011) ---------------- */
INSTR(sb,    "??????? ????? ????? 000 ????? 0100011", 'S')
INSTR(sh,    "??????? ????? ????? 001 ????? 0100011", 'S')
INSTR(sw,    "??????? ????? ????? 010 ????? 0100011", 'S')
INSTR(sd,    "??????? ????? ????? 011 ????? 0100011", 'S')

/* ---------------- 分支 branch (1100011) ---------------- */
INSTR(beq,   "??????? ????? ????? 000 ????? 1100011", 'B')
INSTR(bne,   "??????? ????? ????? 001 ????? 1100011", 'B')
INSTR(blt,   "??????? ????? ????? 100 ????? 1100011", 'B')
INSTR(bge,   "??????? ????? ????? 101 ????? 1100011", 'B')
INSTR(bltu,  "??????? ????? ????? 110 ????? 1100011", 'B')
INSTR(bgeu,  "??????? ????? ????? 111 ????? 1100011", 'B')

/* ---------------- 高位立即数 / 跳转 ---------------- */
INSTR(lui,   "??????? ????? ????? ??? ????? 0110111", 'U')
INSTR(auipc, "??????? ????? ????? ??? ????? 0010111", 'U')
INSTR(jal,   "??????? ????? ????? ??? ????? 1101111", 'J')
INSTR(jalr,  "??????? ????? ????? 000 ????? 1100111", 'I')

/* ---------------- 内存序 fence (0001111) ----------------
 * 单 hart、顺序执行的功能模型里，fence 不影响可见结果（无乱序、无缓存），
 * 但必须能译码 —— 编译器会为原子/MMIO 访问插它。
 * TODO(M5)：实现 C 扩展与缓存模型后，fence.i 需刷新译码缓存。 */
INSTR(fence,   "??????? ????? ????? 000 ????? 0001111", 'N')
INSTR(fence_i, "000000000000 00000 001 00000 0001111", 'N')
