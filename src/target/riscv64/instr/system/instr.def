/*
 * 特权/系统指令表（RV64 骨架最小集）。
 * 格式说明见 instr/i/instr.def。
 *
 * 注意：完全指定的模式必须能区分开——
 *   ecall/ebreak/mret/sret/wfi 的 funct3 都是 000，靠 imm 位域区分；
 *   csr* 靠 funct3 (001/010/011/101/110/111) 区分。
 * 线性扫描表无所谓顺序，但模式本身必须互斥。
 */

INSTR(ecall,      "000000000000 00000 000 00000 1110011", 'N')
INSTR(ebreak,     "000000000001 00000 000 00000 1110011", 'N')
INSTR(mret,       "001100000010 00000 000 00000 1110011", 'N')
INSTR(sret,       "000100000010 00000 000 00000 1110011", 'N')
INSTR(wfi,        "000100000101 00000 000 00000 1110011", 'N')
INSTR(sfence_vma, "0001001 ????? ????? 000 00000 1110011", 'N')

/* CSR 指令（Zicsr）：关掉 CONFIG_RV_ZICSR 时它们变成非法指令 */
#ifdef CONFIG_RV_ZICSR
INSTR(csrrw,      "??????? ????? ????? 001 ????? 1110011", 'I')
INSTR(csrrs,      "??????? ????? ????? 010 ????? 1110011", 'I')
INSTR(csrrc,      "??????? ????? ????? 011 ????? 1110011", 'I')
INSTR(csrrwi,     "??????? ????? ????? 101 ????? 1110011", 'Z')
INSTR(csrrsi,     "??????? ????? ????? 110 ????? 1110011", 'Z')
INSTR(csrrci,     "??????? ????? ????? 111 ????? 1110011", 'Z')
#endif /* CONFIG_RV_ZICSR */

/* 指令流同步（Zifencei）：无译码缓存的功能模型仍需正确识别能力身份。 */
#ifdef CONFIG_RV_ZIFENCEI
INSTR(fence_i, "000000000000 00000 001 00000 0001111", 'N')
#endif /* CONFIG_RV_ZIFENCEI */

/* NEMU 约定：自定义 trap 指令。rs1 位域按惯例写 a0(x10)，
 * 执行时直接读 cpu.gpr[10] 作为退出码。编码（含 a0）= 0x0005006b。 */
INSTR(nemu_trap,  "0000000 00000 ????? 000 00000 1101011", 'N')
